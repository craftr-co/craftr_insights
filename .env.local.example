# Google OAuth (verified sign-in — no database needed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Gmail — all survey responses are emailed to you
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where to receive survey emails (defaults to GMAIL_USER if empty)
NOTIFY_EMAIL=
